{
  "name": "eseller-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "release:preflight": "node scripts/release-preflight.mjs",
    "doctor:device-build": "node scripts/doctor-device-build.mjs",
    "smoke:config": "node scripts/check-mobile-config.mjs",
    "smoke:api-contract": "node scripts/check-api-smoke-contract.mjs",
    "smoke:web": "expo export --platform web --output-dir dist/audit-web",
    "smoke:api": "node scripts/smoke-mobile-api.mjs",
    "smoke:api:auth": "node scripts/smoke-mobile-api-auth.mjs",
    "smoke:roles": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-role-routing.mjs",
    "smoke:hygiene": "node scripts/check-worktree-hygiene.mjs",
    "smoke:herder-cart": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-herder-cart.mjs",
    "smoke:herder-api": "node scripts/check-herder-api-contract.mjs",
    "smoke:herder-offline": "node scripts/check-herder-offline-contract.mjs",
    "smoke:seller-dashboard": "node scripts/check-seller-dashboard-contract.mjs",
    "smoke:device-build": "node scripts/check-device-build-contract.mjs",
    "smoke:product-quality": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-product-quality.mjs",
    "smoke:api-auth-policy": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api-auth-policy.mjs",
    "smoke:public-browsing-auth": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-public-browsing-auth-policy.mjs",
    "smoke:buyer-shortcuts": "node scripts/check-buyer-shortcut-routes.mjs",
    "smoke:buyer-account-auth": "node scripts/check-buyer-account-auth-guards.mjs",
    "smoke:api-paths": "node scripts/check-api-path-segments.mjs",
    "smoke:route-params": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-route-params.mjs",
    "smoke:product-surfaces": "node scripts/check-product-surface-guards.mjs",
    "smoke:route-aliases": "node scripts/check-public-route-aliases.mjs",
    "smoke:route-links": "node scripts/check-public-route-links.mjs",
    "smoke:meta": "node scripts/check-smoke-suite.mjs",
    "smoke:p0": "node scripts/smoke-p0.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.97.0",
    "axios": "^1.15.0",
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
