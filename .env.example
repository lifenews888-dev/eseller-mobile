# ─── Малчнаас шууд (direct-from-herder marketplace, PRD v1.0) ─────────────
# These values are *build-time defaults only*. In production, the app reads
# the same fields from GET /api/config/mobile and the remote value wins.
# Use these for local dev or as the safe fallback when the backend is
# unreachable on first launch.

# Cloudinary — зураг хуулах (unsigned upload preset шаардлагатай)
# https://cloudinary.com/console → Settings → Upload → Upload presets
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=duo61k04v
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=eseller_mobile

# Master kill-switch for the entire herder/coordinator vertical.
# All herder UI, routes, and the role-switcher pill respect this flag.
# Defaults to ON for the pilot; set to "0" or "false" to hide locally.
EXPO_PUBLIC_MALCHNAAS_ENABLED=1

# Seller-network read-only dashboard kill-switch. Defaults to ON for
# dev/internal builds; production can override via /api/config/mobile.
EXPO_PUBLIC_SELLER_NETWORK_ENABLED=1

# OTP/reset-password UI gate. Keep OFF until backend SMS endpoints are live.
EXPO_PUBLIC_OTP_ENABLED=0

# Pilot aimag codes (comma-separated, uppercase). Herder onboarding is
# hard-gated to these aimags so we don't accept applications we can't
# fulfill logistically. Defaults to Архангай / Төв / Сэлэнгэ per PRD §8.
# Codes from src/features/herder/constants.ts PROVINCES.
EXPO_PUBLIC_MALCHNAAS_PILOT_AIMAGS=AKH,TOV,SEL

# API — хөгжүүлэлтийн үед backend хаяг
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.x:3000/api

# Sentry — production/native build only.
# Set these as EAS secrets or CI env vars. The Expo config includes the
# Sentry native plugin only when org + project are both present.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
